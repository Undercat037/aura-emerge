_ae_empty_db() {
  local name="$1"
  local dir="/var/lib/aura-emerge/repos/${name}"
  local tar="${dir}/${name}.db.tar"
  local link="${dir}/${name}.db"
  local sync="/var/lib/pacman/sync/${name}.db"

  install -d -m755 -o root -g root "$dir"
  if [[ ! -e $tar ]]; then
    # 1024 zero bytes = valid empty ustar end marker
    dd if=/dev/zero of="$tar" bs=512 count=2 status=none 2>/dev/null \
      || printf '\0%.0s' {1..1024} >"$tar"
    chmod 644 "$tar"
  fi
  if [[ ! -e $link ]]; then
    ln -sfn "${name}.db.tar" "$link"
  fi
  if [[ -d /var/lib/pacman/sync && ! -e $sync ]]; then
    install -m644 -o root -g root "$tar" "$sync"
  fi
}

_ae_init_localrepos() {
  install -d -m755 -o root -g root /var/lib/aura-emerge/repos
  for name in ae-aur ae-abs ae-local; do
    _ae_empty_db "$name"
  done
}

_ae_eselect_shim() {
  # eselect shim: only when no real eselect (ae-eselect) is installed
  if [[ -x /usr/lib/aura-emerge/eselect-shim ]]; then
    /usr/lib/aura-emerge/eselect-shim "$1" || true
  fi
}

post_install() {
  ln -sf /usr/bin/emerge /usr/bin/portageq
  _ae_eselect_shim install
  _ae_init_localrepos || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  if [[ -L /usr/bin/portageq && $(readlink -- /usr/bin/portageq) == /usr/bin/emerge ]]; then
    rm -f /usr/bin/portageq
  fi
  _ae_eselect_shim remove
}
